#!/usr/bin/env bash
set -euo pipefail

SERVICES=(smbd nmbd)

log() {
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

# Stop services
for s in "${SERVICES[@]}"; do
  log "stopping $s"
  systemctl stop "$s" || log "failed to stop $s"
done

# Disable services
for s in "${SERVICES[@]}"; do
  log "disabling $s"
  systemctl disable "$s" || log "failed to disable $s"
done

# Mask services
for s in "${SERVICES[@]}"; do
  log "masking $s"
  systemctl mask "$s" || log "failed to mask $s"
done

# Show status
for s in "${SERVICES[@]}"; do
  log "status $s"
  systemctl status "$s" --no-pager || true
done
# After disable, report smbclient output (non-fatal)
VERIFY_HOST={{ smb_verify_host | default(ansible_facts['all_ipv4_addresses'][0] | default('127.0.0.1')) }}
log "checking smbclient output against $VERIFY_HOST (expected: not serving)"
smb_output=$(smbclient -L "${VERIFY_HOST}" -N 2>&1 || true)
echo "$smb_output"

log "Disable Samba server completed"

# Copy cron job file for backup jobs and verify that it exists
log "Copying backup cron job file"
cp /home/cce/rayo/scripts/github/crontab_rsync_disable /etc/cron.d/crontab_rsync_disable
ls -l /etc/cron.d/crontab_rsync_disable || { log "failed to copy cron job file"; exit 6; }

# Copy cron job for replication jobs and verify that it exists
log "Copying replication cron job file"
cp /home/cce/rayo/scripts/github/cce_rsync_replication_disabled /etc/cron.d/cce_rsync_replication_disabled
ls -l /etc/cron.d/cce_rsync_replication_disabled || { log "failed to copy cron job file"; exit 7; }
# Remove file /etc/cron.d/cce_rsync_replication_enabled if it exists
if [ -f /etc/cron.d/cce_rsync_replication_enabled ]; then
  log "Removing /etc/cron.d/cce_rsync_replication_enabled"
  rm -f /etc/cron.d/cce_rsync_replication_enabled || { log "failed to remove /etc/cron.d/cce_rsync_replication_enabled"; exit 8; }
fi

log "Disable server completed successfully. Continue accessing the data server."
log "This is the live data server now."
