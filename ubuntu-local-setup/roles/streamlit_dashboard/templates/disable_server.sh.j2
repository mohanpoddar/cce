#!/usr/bin/env bash
set -euo pipefail

SERVICES=(smbd nmbd)

log() {
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

# Stop services
for s in "${SERVICES[@]}"; do
  log "stopping $s"
  systemctl stop "$s" || log "failed to stop $s"
done

# Disable services
for s in "${SERVICES[@]}"; do
  log "disabling $s"
  systemctl disable "$s" || log "failed to disable $s"
done

# Mask services
for s in "${SERVICES[@]}"; do
  log "masking $s"
  systemctl mask "$s" || log "failed to mask $s"
done

# Show status
for s in "${SERVICES[@]}"; do
  log "status $s"
  systemctl status "$s" --no-pager || true
done
# After disable, report smbclient output (non-fatal)
VERIFY_HOST={{ smb_verify_host | default(ansible_facts['all_ipv4_addresses'][0] | default('127.0.0.1')) }}
log "checking smbclient output against $VERIFY_HOST (expected: not serving)"
smb_output=$(smbclient -L "${VERIFY_HOST}" -N 2>&1 || true)
echo "$smb_output"

log "disable_server completed"
