#!/usr/bin/env bash
set -euo pipefail

SERVICES=(smbd nmbd)

log() {
  echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*"
}

# Unmask services
for s in "${SERVICES[@]}"; do
  log "unmasking $s"
  systemctl unmask "$s" || { log "failed to unmask $s"; exit 2; }
done

# Enable services
for s in "${SERVICES[@]}"; do
  log "enabling $s"
  systemctl enable "$s" || { log "failed to enable $s"; exit 3; }
done

# Start services if enabled and not already active
for s in "${SERVICES[@]}"; do
  if systemctl is-enabled --quiet "$s"; then
    if ! systemctl is-active --quiet "$s"; then
      log "starting $s"
      systemctl start "$s" || { log "failed to start $s"; exit 4; }
    else
      log "$s already active"
    fi
  else
    log "$s not enabled; skipping start"
  fi
done

# Show status for debugging
for s in "${SERVICES[@]}"; do
  log "status $s"
  systemctl status "$s" --no-pager || true
done

# Verify Samba reachability using smbclient; configured at template render time
VERIFY_HOST={{ smb_verify_host | default(ansible_facts['all_ipv4_addresses'][0] | default('127.0.0.1')) }}

log "verifying samba with smbclient against localhost, 127.0.0.1 and $VERIFY_HOST"
# Try multiple hosts to increase chance of successful verification and show which one works
smb_output=""
  for h in localhost 127.0.0.1 "${VERIFY_HOST}"; do
  log "trying smbclient against $h"
  # Use absolute path to smbclient to avoid PATH differences under sudo
  attempt=$(/usr/bin/smbclient -L "$h" -N 2>&1 || true)
  echo "--- smbclient output for $h ---"
  echo "$attempt"
  echo "--- smbclient exit code: $? ---"
  if [ -n "$attempt" ]; then
    smb_output="$attempt"
    break
  fi
done

if [ -z "$smb_output" ]; then
  log "smbclient produced no output on any tested host; verification may have failed"
  exit 5
fi

log "Enable Samba server completed"

# Copy cron job file for backup jobs and verify that it exists
log "Copying backup cron job file"
cp /home/cce/rayo/scripts/github/crontab_rsync_enable /etc/cron.d/crontab_rsync_enable
ls -l /etc/cron.d/crontab_rsync_enable || { log "failed to copy cron job file"; exit 6; }

# Remove /etc/cron.d/crontab_rsync_common and /etc/cron.d/crontab_rsync_disable if they exist
if [ -f /etc/cron.d/crontab_rsync_common ]; then
  log "Removing /etc/cron.d/crontab_rsync_common"
  rm -f /etc/cron.d/crontab_rsync_common || { log "failed to remove /etc/cron.d/crontab_rsync_common"; exit 7; }
fi

if [ -f /etc/cron.d/crontab_rsync_disable ]; then
  log "Removing /etc/cron.d/crontab_rsync_disable"
  rm -f /etc/cron.d/crontab_rsync_disable || { log "failed to remove /etc/cron.d/crontab_rsync_disable"; exit 7; }
fi

# Copy cron job for replication jobs and verify that it exists
log "Copying replication cron job file"
cp /home/cce/rayo/scripts/github/cce_rsync_replication_enabled /etc/cron.d/cce_rsync_replication_enabled
ls -l /etc/cron.d/cce_rsync_replication_enabled || { log "failed to copy cron job file"; exit 7; }
# Remove /etc/cron.d/cce_rsync_replication_disabled if it exists
if [ -f /etc/cron.d/cce_rsync_replication_disabled ]; then
  log "Removing /etc/cron.d/cce_rsync_replication_disabled"
  rm -f /etc/cron.d/cce_rsync_replication_disabled || { log "failed to remove /etc/cron.d/cce_rsync_replication_disabled"; exit 8; }
fi

log "Enable server completed successfully. Continue accessing the data server."
log "This is the live data server now."
