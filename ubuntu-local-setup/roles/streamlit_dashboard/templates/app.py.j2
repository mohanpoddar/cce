def render_styles(palette):
    s = STYLES_TEMPLATE
    s = s.replace("__BG_GRAD__",        palette["bg_grad"])
    s = s.replace("__TEXT__",           palette["text"])
    s = s.replace("__PANEL__",          palette["panel"])
    s = s.replace("__PANEL_2__",        palette["panel_2"])
    s = s.replace("__MUTED__",          palette["muted"])
    s = s.replace("__BORDER__",         palette["border"])
    s = s.replace("__BORDER_STRONG__",  palette["border_strong"])
    s = s.replace("__ACCENT__",         palette["accent"])
    s = s.replace("__ACCENT_2__",       palette["accent_2"])
    s = s.replace("__OK__",             palette["ok"])
    s = s.replace("__WARN__",           palette["warn"])
    s = s.replace("__DANGER__",         palette["danger"])
    return s


