import streamlit as st
import subprocess
import shlex

st.set_page_config(page_title="Devopsadmin Dashboard", page_icon="📊")
st.markdown("""
<style>
:root{
    --bg:#071018; --panel:#0f1720; --muted:#94a3b8; --accent:#0ea5ff; --card:#0b1220; --glass: rgba(255,255,255,0.02);
}
body { background: linear-gradient(180deg,#071018 0%, #041018 100%); }
.dashboard { padding: 16px 8px; }
.grid { display: grid; grid-template-columns: 1fr 360px; gap: 16px; align-items: start; }
.card { background: linear-gradient(180deg,var(--card), #08121a); border-radius:12px; padding:14px; box-shadow: 0 6px 18px rgba(2,6,23,0.6); border:1px solid rgba(255,255,255,0.03); }
.action-row{ display:flex; gap:12px; align-items:center; padding:10px; border-radius:10px; background: var(--glass); margin-bottom:10px; }
.icon-wrap{ width:56px; height:56px; display:flex; align-items:center; justify-content:center; background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01)); border-radius:10px; }
.title{ font-weight:700; font-size:16px; color:#e6eef8; }
.subtitle{ color:var(--muted); font-size:13px; }
.run { background: linear-gradient(90deg,var(--accent), #3db5ff); color: #042028; padding:8px 12px; border-radius:8px; border:none; font-weight:600; }
.run:hover{ transform: translateY(-1px); }
.output { background:#071722; border-radius:8px; padding:10px; color:#cfe9ff; font-family: monospace; white-space: pre-wrap; }
.small { color:var(--muted); font-size:12px }
</style>
""", unsafe_allow_html=True)

st.markdown("""
<div style='display:flex;align-items:center;gap:12px'>
    <h1 style='margin:0;color:#e6eef8'>Devopsadmin Dashboard</h1>
    <div style='color:var(--muted);font-size:14px'> — Streamlined actions for operators</div>
</div>
""", unsafe_allow_html=True)

st.markdown("<div class='dashboard'>", unsafe_allow_html=True)

# Build actions list from structured defaults if available, otherwise fall back to simple commands
actions = []
{% if streamlit_actions is defined and streamlit_actions|length > 0 %}
{% for a in streamlit_actions %}
actions.append({"name": "{{ a.name }}", "icon": "{{ a.icon }}", "command": "{{ a.command }}"})
{% endfor %}
{% elif streamlit_commands is defined and streamlit_commands|length > 0 %}
{% for cmd in streamlit_commands %}
actions.append({"name": "{{ cmd.split()[-1] }}", "icon": "⚙️", "command": "{{ cmd }}"})
{% endfor %}
{% endif %}

# Session state for pending action confirmation
if 'pending_action' not in st.session_state:
    st.session_state['pending_action'] = None

log_file = "{{ log_file }}"
# Render Python booleans correctly
enable_confirmation = {{ 'True' if enable_confirmation|default(true) else 'False' }}
base_assets_dir = "{{ app_parent_dir }}/assets"

def append_log(entry):
    try:
        with open(log_file, 'a') as f:
            f.write(entry + "\n")
    except Exception as _:
        pass

for idx, action in enumerate(actions):
    # path to icon asset (role-managed)
    icon_path = f"file://{base_assets_dir}/{action['icon']}.svg"

    with st.container():
        st.markdown("<div class='card'>", unsafe_allow_html=True)
        cols = st.columns([0.12, 0.68, 0.2])
        with cols[0]:
            st.markdown(f"<div class='icon-wrap'><img src='{icon_path}' width='48' /></div>", unsafe_allow_html=True)
        with cols[1]:
            st.markdown(f"<div class='title'>{action['name']}</div>")
            st.markdown(f"<div class='subtitle'>{action['command']}</div>", unsafe_allow_html=True)
        with cols[2]:
            run_key = f"run_{idx}"
            confirm_key = f"confirm_{idx}"
            if st.button("Run", key=run_key):
                st.session_state['pending_action'] = idx

        st.markdown("</div>", unsafe_allow_html=True)

        # If this action is pending, show confirmation and output area
        if st.session_state.get('pending_action') == idx:
            with st.expander("Action details and result", expanded=True):
                if enable_confirmation:
                    st.warning(f"Are you sure you want to run **{action['name']}**?")
                    if st.button("Confirm", key=confirm_key):
                        placeholder = st.empty()
                        try:
                            args = ["sudo"] + shlex.split(action['command'])
                            result = subprocess.run(args, capture_output=True, text=True)
                            out = result.stdout or ""
                            err = result.stderr or ""
                            code = result.returncode
                            timestamp = __import__('datetime').datetime.utcnow().isoformat()
                            log_entry = f"{timestamp} | {action['name']} | {action['command']} | return={code} | out={out.strip()} | err={err.strip()}"
                            append_log(log_entry)
                            placeholder.markdown(f"**Return code:** {code}")
                            if out:
                                placeholder.markdown('<div class="output">' + out.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
                            if err:
                                placeholder.markdown('<div class="output">' + err.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
                        except Exception as e:
                            st.error(str(e))
                        finally:
                            st.session_state['pending_action'] = None
                else:
                    # No confirmation flow
                    placeholder = st.empty()
                    try:
                        args = ["sudo"] + shlex.split(action['command'])
                        result = subprocess.run(args, capture_output=True, text=True)
                        out = result.stdout or ""
                        err = result.stderr or ""
                        code = result.returncode
                        timestamp = __import__('datetime').datetime.utcnow().isoformat()
                        log_entry = f"{timestamp} | {action['name']} | {action['command']} | return={code} | out={out.strip()} | err={err.strip()}"
                        append_log(log_entry)
                        placeholder.markdown(f"**Return code:** {code}")
                        if out:
                            placeholder.markdown('<div class="output">' + out.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
                        if err:
                            placeholder.markdown('<div class="output">' + err.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
                    except Exception as e:
                        st.error(str(e))
                    finally:
                        st.session_state['pending_action'] = None

