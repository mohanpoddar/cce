# -- Actions tab ----------------------------------------------------------
with tab_actions:
    st.markdown("#### All actions")
    query = st.text_input(
        "Search actions",
        placeholder="Filter by name or command\u2026",
        label_visibility="collapsed",
    )

    ENABLE_OPS = {"unmask", "enable", "start"}
    DISABLE_OPS = {"mask", "disable", "stop"}

    def cmd_op(cmd):
        parts = cmd.split()
        if "systemctl" in parts:
            i = parts.index("systemctl")
            if i + 1 < len(parts):
                return parts[i + 1]
        return ""

    grouped = {"Enable Flow": [], "Disable Flow": [], "Other": []}
    for a in ACTIONS:
        op = cmd_op(a.get("command", ""))
        if op in ENABLE_OPS:
            grouped["Enable Flow"].append(a)
        elif op in DISABLE_OPS:
            grouped["Disable Flow"].append(a)
        elif a.get("icon") in ("enable_server", "disable_server"):
            continue  # already shown in overview
        else:
            grouped["Other"].append(a)

    def matches(a):
        if not query:
            return True
        q = query.lower()
        return q in a["name"].lower() or q in a["command"].lower()

    # Confirmation dialog (Streamlit >= 1.31)
    confirm_dialog_fn = None
    try:
        @st.dialog("Confirm action", width="small")
        def confirm_dialog_fn(name, command, key):
            st.write("You are about to run **" + name + "**.")
            st.code(command, language="bash")
            st.warning("This will execute the command with elevated privileges.")
            a, b = st.columns(2)
            with a:
                if st.button("Cancel", key="cancel_" + key, use_container_width=True):
                    st.session_state.pending_action = None
                    st.rerun()
            with b:
                if st.button("Confirm & run", key="confirm_" + key, type="primary", use_container_width=True):
                    st.session_state.confirmed = {
                        "name": name, "command": command, "key": key,
                    }
                    st.session_state.pending_action = None
                    st.rerun()
    except Exception:
        pass

    def action_row(a, idx):
        key = "act_" + str(idx)
        cols = st.columns([0.6, 0.18, 0.22])
        with cols[0]:
            st.markdown(
                "<div class='ar' style='margin-bottom:0;'>"
                "<div class='ico'>" + get_status_icon_svg(a["icon"]) + "</div>"
                "<div>"
                "<div class='name'>" + _escape(a["name"]) + "</div>"
                "<div class='cmd'>" + _escape(a["command"]) + "</div>"
                "</div>"
                "</div>",
                unsafe_allow_html=True,
            )
        with cols[2]:
            if st.button("Run", key="run_" + key, use_container_width=True):
                st.session_state.pending_action = {
                    "key": key, "name": a["name"], "command": a["command"],
                }
                if confirm_dialog_fn is not None:
                    confirm_dialog_fn(a["name"], a["command"], key)
                st.rerun()

    # Handle confirmation result
    if st.session_state.get("confirmed"):
        c = st.session_state.confirmed
        st.session_state.confirmed = None
        st.markdown("##### \u25B6 Running: " + c["name"])
        out_container = st.container()
        with out_container:
            run_command_streaming(c["name"], c["command"], out_container)

    for group_name in ("Enable Flow", "Disable Flow", "Other"):
        items = [a for a in grouped[group_name] if matches(a)]
        if not items:
            continue
        st.markdown("##### " + group_name)
        for a in items:
            action_row(a, hash(a["command"]) & 0xFFFF)

    if not any(grouped.values()):
        st.info("No actions configured. Add entries to `streamlit_actions` in your Ansible vars.")

# -- Activity log tab -----------------------------------------------------
with tab_log:
    st.markdown("#### Activity log")
    st.caption("Append-only log of action executions. Path: `" + LOG_FILE + "`")

    col_a, col_b, col_c = st.columns([0.5, 0.25, 0.25])
    with col_a:
        limit = st.select_slider(
            "Show last N entries",
            options=[50, 100, 200, 500, 1000], value=200,
        )
    with col_b:
        if st.button("\U0001F504 Refresh", key="log_refresh", use_container_width=True):
            st.rerun()
    with col_c:
        log_text = "\n".join(load_log(limit=limit))
        st.download_button(
            "\u2B07\uFE0F Download",
            data=log_text or "",
            file_name="actions.log",
            mime="text/plain",
            use_container_width=True,
            disabled=not bool(log_text),
        )

    entries = load_log(limit=limit)
    if not entries:
        st.info("No log entries yet.")
    else:
        for line in entries:
            if "return=0" in line:
                klass = "ok"
            elif "return=" in line:
                klass = "err"
            else:
                klass = "info"
            st.markdown(
                "<div class='console'><div class='" + klass + "'>"
                + _escape(line) + "</div></div>",
                unsafe_allow_html=True,
            )

# -- Help tab -------------------------------------------------------------
with tab_help:
    st.markdown("#### About this dashboard")
    st.markdown(
        "This dashboard is generated by the `streamlit_dashboard` Ansible role and runs as a "
        "systemd service. It exposes a curated set of operator actions that are authorized "
        "via a dedicated sudoers drop-in file.\n\n"
        "**How it works**\n"
        "1. Configure actions in `streamlit_actions` (defaults or group_vars).\n"
        "2. The role installs a Python venv with Streamlit and deploys this app.\n"
        "3. A systemd unit (`streamlit-dashboard.service`) keeps the app running on port `8501`.\n"
        "4. Each click runs the configured command via `sudo`, streams stdout/stderr live, "
        "and appends a structured line to `actions.log`.\n\n"
        "**Security**\n"
        "- Commands are executed with the unprivileged `app_user`; only the whitelisted commands "
        "are granted via `/etc/sudoers.d/devopsadmin_streamlit`.\n"
        "- Confirmation is required before any state-changing command."
    )

st.markdown(
    "<div class='footer'>Devopsadmin Dashboard \u00B7 Streamlit \u00B7 built by Ansible</div>",
    unsafe_allow_html=True,
)
