def get_status_icon_svg(name):
    if name in ICON_SVGS:
        return ICON_SVGS[name]
    try:
        p = ASSETS_DIR / (name + ".svg")
        if p.exists():
            return p.read_text(encoding="utf-8")
    except Exception:
        pass
    return '<svg viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="4"/></svg>'


def _escape(s):
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def run_command_streaming(name, command, container):
    log_lines = []
    code_box = container.empty()
    out_box = container.empty()

    try:
        args = ["sudo"] + shlex.split(command)
    except Exception as e:
        container.error("Could not parse command: " + str(e))
        return 1, ""

    try:
        proc = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError as e:
        container.error("Failed to launch: " + str(e))
        return 127, ""

    start = time.time()
    if proc.stdout:
        for raw in iter(proc.stdout.readline, ""):
            line = raw.rstrip("\n")
            log_lines.append(line)
            html = "".join(
                "<div class='info'>" + _escape(l) + "</div>" for l in log_lines[-200:]
            )
            out_box.markdown(
                "<div class='console'>" + html + "</div>",
                unsafe_allow_html=True,
            )
        proc.stdout.close()

    code = proc.wait()
    duration = time.time() - start
    ts = dt.datetime.utcnow().isoformat()
    append_log(
        ts + " | " + name + " | " + command + " | return=" + str(code)
        + " | duration=" + format(duration, ".2f") + "s"
        + " | out=" + (" | ".join(log_lines))[:4000]
    )

    css_class = "ok" if code == 0 else "err"
    code_box.markdown(
        "<div class='console'>"
        "<div class='" + css_class + "'>\u25CF Return code: " + str(code) + "</div>"
        "<div class='info'>Duration: " + format(duration, ".2f") + "s</div>"
        "</div>",
        unsafe_allow_html=True,
    )
    return code, "\n".join(log_lines)


def shell_capture(command, timeout=1.5):
    try:
        out = subprocess.run(
            ["sudo"] + shlex.split(command),
            capture_output=True, text=True, timeout=timeout,
        )
        return (out.stdout or "") + (out.stderr or "")
    except Exception:
        return ""


def get_service_state(service):
    out = shell_capture("/usr/bin/systemctl is-active " + service).strip()
    if out in ("active", "inactive", "masked", "failed", "unknown"):
        return out
    return "unknown"


