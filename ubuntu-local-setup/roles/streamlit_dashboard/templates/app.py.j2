def run_command_streaming(name: str, command: str, container) -> tuple[int, str]:
    """Run a command via sudo and stream output into a Streamlit container."""
    log_lines: list[str] = []
    code_box = container.empty()
    out_box  = container.empty()

    try:
        args = ["sudo"] + shlex.split(command)
    except Exception as e:
        container.error(f"Could not parse command: {e}")
        return 1, ""

    try:
        proc = subprocess.Popen(
            args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            text=True, bufsize=1,
        )
    except FileNotFoundError as e:
        container.error(f"Failed to launch: {e}")
        return 127, ""

    start = time.time()
    if proc.stdout:
        for raw in iter(proc.stdout.readline, ""):
            line = raw.rstrip("\n")
            log_lines.append(line)
            html = "".join(f"<div class='info'>{_escape(l)}</div>" for l in log_lines[-200:])
            out_box.markdown(f"<div class='console'>{html}</div>", unsafe_allow_html=True)
        proc.stdout.close()

    code = proc.wait()
    duration = time.time() - start
    ts = dt.datetime.utcnow().isoformat()
    append_log(
        f"{ts} | {name} | {command} | return={code} | duration={duration:.2f}s | "
        f"out={(' | '.join(log_lines))[:4000]}"
    )

    css_class = "ok" if code == 0 else "err"
    code_box.markdown(
        f"<div class='console'><div class='{css_class}'>● Return code: {code}</div>"
        f"<div class='info'>Duration: {duration:.2f}s</div></div>",
        unsafe_allow_html=True,
    )
    return code, "\n".join(log_lines)


def _escape(s: str) -> str:
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def shell_capture(command: str, timeout: float = 1.5) -> str:
    try:
        out = subprocess.run(
            ["sudo"] + shlex.split(command),
            capture_output=True, text=True, timeout=timeout,
        )
        return (out.stdout or "") + (out.stderr or "")
    except Exception:
        return ""


def get_service_state(service: str) -> str:
    out = shell_capture(f"/usr/bin/systemctl is-active {service}").strip()
    return out if out in ("active", "inactive", "masked", "failed", "unknown") else "unknown"


