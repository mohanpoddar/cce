st.markdown("""
<div style='display:flex;align-items:center;gap:12px'>
    <h1 style='margin:0;color:#e6eef8'>Devopsadmin Dashboard</h1>
    <div style='color:var(--muted);font-size:14px'> — Streamlined actions for operators</div>
</div>
""", unsafe_allow_html=True)

st.markdown("<div class='dashboard'>", unsafe_allow_html=True)

# Build actions list
actions = []
{% if streamlit_actions is defined and streamlit_actions|length > 0 %}
{% for a in streamlit_actions %}
actions.append({"name": "{{ a.name }}", "icon": "{{ a.icon }}", "command": "{{ a.command }}"})
{% endfor %}
{% endif %}

log_file = "{{ log_file }}"
base_assets_dir = "{{ app_parent_dir }}/assets"
app_parent_dir = "{{ app_parent_dir }}"

if 'pending_action' not in st.session_state:
    st.session_state['pending_action'] = None

def append_log(entry):
    try:
        with open(log_file, 'a') as f:
            f.write(entry + "\n")
    except Exception:
        pass

def execute_and_display(name, command):
    placeholder = st.empty()
    try:
        args = ['sudo'] + shlex.split(command)
        result = subprocess.run(args, capture_output=True, text=True)
        out = result.stdout or ''
        err = result.stderr or ''
        code = result.returncode
        timestamp = __import__('datetime').datetime.utcnow().isoformat()
        log_entry = f"{timestamp} | {name} | {command} | return={code} | out={out.strip()} | err={err.strip()}"
        append_log(log_entry)
        placeholder.markdown(f"**Return code:** {code}")
        if out:
            placeholder.markdown('<div class="output">' + out.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
        if err:
            placeholder.markdown('<div class="output">' + err.replace('\n','<br>') + '</div>', unsafe_allow_html=True)
        # Also show the recent action log file contents, if present
        try:
            p = Path(log_file)
            if p.exists():
                log_text = p.read_text(encoding='utf-8')
                tail_lines = log_text.splitlines()[-200:]
                if tail_lines:
                    placeholder.markdown('<div class="output"><strong>Action log (last {} lines):</strong><br>'.format(len(tail_lines)) + '<br>'.join(tail_lines) + '</div>', unsafe_allow_html=True)
        except Exception:
            pass
    except Exception as e:
        st.error(str(e))

# Helpers to find action indices by exact command
action_index_by_command = {a['command']: i for i,a in enumerate(actions)}

# Primary Enable/Disable tiles (top)
# Detect primary actions by icon or by command path ending with the script names
enable_action = next((a for a in actions if a.get('icon')=='enable_server' or (a.get('command') and a.get('command').endswith('/scripts/enable_server.sh'))), None)
disable_action = next((a for a in actions if a.get('icon')=='disable_server' or (a.get('command') and a.get('command').endswith('/scripts/disable_server.sh'))), None)
if enable_action or disable_action:
    st.markdown("<div class='card'>", unsafe_allow_html=True)
    c1, c2 = st.columns([0.5,0.5])

    # Enable primary
    enable_cmd = enable_action['command'] if enable_action else None
    enable_icon = enable_action.get('icon') if enable_action else 'enable_server'
    with c1:
        if enable_cmd:
            try:
                p = Path(base_assets_dir) / f"{enable_icon}.svg"
                svg = p.read_text(encoding='utf-8') if p.exists() else ''
            except Exception:
                svg = ''
            if svg:
                st.markdown(f"<div class='icon-wrap'>{svg}</div>", unsafe_allow_html=True)
            st.markdown(f"<div class='title'>Enable Server</div>", unsafe_allow_html=True)
            st.markdown(f"<div class='subtitle'>{enable_cmd}</div>", unsafe_allow_html=True)
            if st.button('Run', key='run_primary_enable'):
                st.session_state['pending_action'] = 'primary_enable'
            if st.session_state.get('pending_action') == 'primary_enable':
                st.warning('Are you sure you want to run Enable Server?')
                if st.button('Confirm', key='confirm_primary_enable'):
                    execute_and_display('Enable Server', enable_cmd)
                    st.session_state['pending_action'] = None

    # Disable primary
    disable_cmd = disable_action['command'] if disable_action else None
    disable_icon = disable_action.get('icon') if disable_action else 'disable_server'
    with c2:
        if disable_cmd:
            try:
                p = Path(base_assets_dir) / f"{disable_icon}.svg"
                svg = p.read_text(encoding='utf-8') if p.exists() else ''
            except Exception:
                svg = ''
            if svg:
                st.markdown(f"<div class='icon-wrap'>{svg}</div>", unsafe_allow_html=True)
            st.markdown(f"<div class='title'>Disable Server</div>", unsafe_allow_html=True)
            st.markdown(f"<div class='subtitle'>{disable_cmd}</div>", unsafe_allow_html=True)
            if st.button('Run', key='run_primary_disable'):
                st.session_state['pending_action'] = 'primary_disable'
            if st.session_state.get('pending_action') == 'primary_disable':
                st.warning('Are you sure you want to run Disable Server?')
                if st.button('Confirm', key='confirm_primary_disable'):
                    execute_and_display('Disable Server', disable_cmd)
                    st.session_state['pending_action'] = None

    st.markdown('</div>', unsafe_allow_html=True)

# Two-column command lists
left_ops = ['unmask','enable','start','status']
right_ops = ['mask','disable','stop','status']
services = ['smbd','nmbd']

st.markdown("<div class='card'>", unsafe_allow_html=True)
left_col, divider_col, right_col = st.columns([0.48, 0.02, 0.48])

with divider_col:
    st.markdown("<div style='width:3px; background: rgba(255,255,255,0.08); height:100%; margin:0 auto; border-radius:3px'></div>", unsafe_allow_html=True)

def render_row_for(op, svc, side):
    cmd = f"/usr/bin/systemctl {op} {svc}"
    action_idx = action_index_by_command.get(cmd)
    name = f"{op.capitalize()} {svc}"
    icon = 'status'
    if action_idx is not None:
        action = actions[action_idx]
        name = action.get('name')
        icon = action.get('icon')
    svg = ''
    try:
        p = Path(base_assets_dir) / f"{icon}.svg"
        svg = p.read_text(encoding='utf-8') if p.exists() else ''
    except Exception:
        svg = ''
    cols = st.columns([0.12, 0.68, 0.2])
    with cols[0]:
        if svg:
            st.markdown(f"<div class='icon-wrap'>{svg}</div>", unsafe_allow_html=True)
        else:
            st.markdown("<div class='icon-wrap'></div>", unsafe_allow_html=True)
    with cols[1]:
        st.markdown(f"<div class='title'>{name}</div>", unsafe_allow_html=True)
        st.markdown(f"<div class='subtitle'>{cmd}</div>", unsafe_allow_html=True)
    key = f"run_{svc}_{op}_{side}"
    confirm = f"confirm_{svc}_{op}_{side}"
    with cols[2]:
        if st.button('Run', key=key):
            st.session_state['pending_action'] = key
    if st.session_state.get('pending_action') == key:
        st.warning(f"Are you sure you want to run **{name}**?")
        if st.button('Confirm', key=confirm):
            execute_and_display(name, cmd)
            st.session_state['pending_action'] = None

with left_col:
    st.markdown("<strong style='color:#e6eef8'>Enable Flow</strong>", unsafe_allow_html=True)
    for svc in services:
        for op in left_ops:
            render_row_for(op, svc, 'L')

with right_col:
    st.markdown("<strong style='color:#e6eef8'>Disable Flow</strong>", unsafe_allow_html=True)
    for svc in services:
        for op in right_ops:
            render_row_for(op, svc, 'R')

st.markdown('</div>', unsafe_allow_html=True)

# Render any other actions that are not standard systemctl ones
systemctl_cmds = set(f"/usr/bin/systemctl {op} {svc}" for svc in services for op in (left_ops+right_ops))
for i,a in enumerate(actions):
    if a['command'] in systemctl_cmds or a.get('icon') in ('enable_server','disable_server'):
        continue
    # render as normal row
    cols = st.columns([0.12, 0.68, 0.2])
    svg = ''
    try:
        p = Path(base_assets_dir) / f"{a.get('icon')}.svg"
        svg = p.read_text(encoding='utf-8') if p.exists() else ''
    except Exception:
        svg = ''
    with cols[0]:
        if svg:
            st.markdown(f"<div class='icon-wrap'>{svg}</div>", unsafe_allow_html=True)
        else:
            st.markdown("<div class='icon-wrap'></div>", unsafe_allow_html=True)
    with cols[1]:
        st.markdown(f"<div class='title'>{a.get('name')}</div>", unsafe_allow_html=True)
        st.markdown(f"<div class='subtitle'>{a.get('command')}</div>", unsafe_allow_html=True)
    run_key = f"run_other_{i}"
    confirm_key = f"confirm_other_{i}"
    with cols[2]:
        if st.button('Run', key=run_key):
            st.session_state['pending_action'] = run_key
    if st.session_state.get('pending_action') == run_key:
        st.warning(f"Are you sure you want to run **{a.get('name')}**?")
        if st.button('Confirm', key=confirm_key):
            execute_and_display(a.get('name'), a.get('command'))
            st.session_state['pending_action'] = None

st.markdown('</div>', unsafe_allow_html=True)
